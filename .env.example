# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL CONFIGURATION (Required for Contact Form)
# EMAIL_HOST: SMTP server host (e.g., smtp.office365.com for Outlook, smtp.gmail.com for Gmail)
EMAIL_HOST=""
# EMAIL_PORT: SMTP server port (587 for STARTTLS, 465 for SSL)
EMAIL_PORT="587"
# EMAIL_USER: SMTP user email (e.g., info@curtaincares.com)
EMAIL_USER=""
# EMAIL_PASS: SMTP password (For Microsoft 365 or Gmail with 2FA, you MUST use an 'App Password')
# To create a Microsoft App Password:
# 1. Visit: https://mysignins.microsoft.com/security-info
# 2. Click "+ Add sign-in method" -> Choose "App password"
# NOTE: If "App password" is missing, your Admin must enable it in MFA Service Settings.
EMAIL_PASS=""
# EMAIL_TO: Recipient email address
EMAIL_TO="info@curtaincares.com"

# IMPORTANT FOR MICROSOFT 365 USERS:
# You must enable 'Authenticated SMTP' in the Microsoft 365 Admin Center for the user account.
# See: https://aka.ms/smtp_auth_disabled

